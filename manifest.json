{
  "manifest_version": 3,
  "name": "Full Size Images for IG",
  "version": "0.4.1",
  "description": "Extension to display IG images at full size.",

  "icons": {
    "16": "images/ico16.png",
    "32": "images/ico32.png",
    "48": "images/ico48.png",
    "128": "images/ico128.png"
  },

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": ["https://*.instagram.com/*"]
    }
  ]
}
